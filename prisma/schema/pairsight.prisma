// PairSight (docs/PairSight-Delivery-Plan.md, "Data model"). Every table is
// user-scoped through its evaluation, so each create migration is followed by
// an ENABLE ROW LEVEL SECURITY migration (no policy, no FORCE) —
// docs/rules/auth.md. Authorization itself lives in the action layer: every
// query goes through src/server/pairsight/store.ts, scoped to the owner.
//
// ownerId is a PLAIN @db.Uuid (User.id = the Supabase auth uuid) with no
// @relation, the same choice as FeatureFlagOverride.userId: a relation would
// force a back-relation onto User in another schema file. It is null only for
// the prepared demo evaluation.

enum EvaluationKind {
	live
	demo
}

enum RunOrigin {
	live
	prepared
}

enum RunStatus {
	running
	completed
	// A configuration problem (missing or rejected Jev key) that no retry
	// can fix; the run keeps its assessments and can resume once fixed.
	stopped
}

enum AssessmentStatus {
	pending
	running
	succeeded
	failed
}

enum VendorExportFormat {
	pair
	group
}

// What the records are (src/lib/pairsight/entity-types.ts): it decides the
// fields, the blocking presets and how a pair is put to Jev.
enum EntityType {
	person
	company
	product
}

model Evaluation {
	id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	ownerId           String?         @db.Uuid
	name              String
	kind              EvaluationKind  @default(live)
	// Set when the records are saved: detected from the file, confirmed by
	// the user. Null until then.
	entityType        EntityType?
	// Draft configuration; each run freezes a copy of it.
	identitySame      String
	identityDifferent String
	countryCode       String          @default("US")
	// Identity roles sent to Jev (src/server/pairsight/fields.ts).
	jevFields         String[]
	// BlockingRule[] (src/server/pairsight/blocking.ts).
	blockingRules     Json
	// Whether the Plan adds the pairs Splink picked (splink/picks.ts) to the
	// rules' and vendors' pairs. On unless switched off in Rules.
	splinkPicks       Boolean         @default(true)
	threshold         Float           @default(0.5)
	createdAt         DateTime        @default(now()) @db.Timestamptz(6)
	updatedAt         DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
	datasets          SourceDataset[]
	vendorExports     VendorExport[]
	vendorDrafts      VendorDraft[]
	runs              Run[]
	uploads           Upload[]

	@@index([ownerId, updatedAt])
	@@map("evaluations")
}

// Immutable: replacing the source file creates a new dataset, so earlier runs
// and their assessments keep pointing at exactly the records they judged.
model SourceDataset {
	id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	evaluationId    String         @db.Uuid
	evaluation      Evaluation     @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
	fileName        String
	rowCount        Int
	referenceColumn String
	// { [header]: FieldRole }
	columnRoles     Json
	createdAt       DateTime       @default(now()) @db.Timestamptz(6)
	// Set once every record is in: records are written in batches, and a
	// dataset still being written (or left half-written) is never used.
	savedAt         DateTime?      @default(now()) @db.Timestamptz(6)
	// Splink's scoring of its pairs (src/server/pairsight/splink/), run by the
	// background worker: the dataset row is the job, as a run is. Null until
	// first asked for (on save, or when its Plan is first opened), so datasets
	// from before Splink aren't all scored at once.
	scoreStatus     ScoreStatus?
	scoreClaimedAt  DateTime?      @db.Timestamptz(6)
	scoredAt        DateTime?      @db.Timestamptz(6)
	// How it went: versions, timings, pairs scored and kept, or why skipped.
	scoreSummary    Json?
	records         SourceRecord[]
	pairScores      PairScore[]
	vendorExports   VendorExport[]
	vendorDrafts    VendorDraft[]
	runs            Run[]
	assessments     Assessment[]

	@@index([evaluationId, createdAt])
	// The worker looks for datasets to score every second.
	@@index([scoreStatus, scoreClaimedAt])
	@@map("source_datasets")
}

enum ScoreStatus {
	pending
	running
	done
	// Not scored, for a reason in scoreSummary: too few records, a type
	// Splink doesn't do yet, or Splink not set up on this server.
	skipped
	failed
}

// One pair Splink scored as worth checking, for one dataset (canonical
// order: the smaller record id first). Only pairs above the service's
// storage floor, at most a run's worth. Splink only picks pairs; Jev still
// judges every one (docs/rules/splink-service.md).
model PairScore {
	datasetId        String        @db.Uuid
	dataset          SourceDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
	recordAId        String        @db.Uuid
	recordBId        String        @db.Uuid
	matchWeight      Float
	matchProbability Float

	@@id([datasetId, recordAId, recordBId])
	// The Plan reads a dataset's pairs above its floor, best first.
	@@index([datasetId, matchWeight])
	@@map("pair_scores")
}

model SourceRecord {
	id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	datasetId String        @db.Uuid
	dataset   SourceDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
	reference String
	rowNumber Int
	// Original cell values keyed by header — shown as-is in pair inspection.
	values    Json
	// For reading results in the database (record-keys.ts): the record's name
	// as shown on Results, its reference padded so text order is natural
	// order (R2 before R10), and both lowercased for search. Filled when the
	// records are saved, or on first read for records saved before.
	label      String?
	sortKey    String?
	searchText String?

	@@unique([datasetId, reference])
	@@index([datasetId, sortKey])
	@@map("source_records")
}

model VendorExport {
	id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	evaluationId        String             @db.Uuid
	evaluation          Evaluation         @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
	datasetId           String             @db.Uuid
	dataset             SourceDataset      @relation(fields: [datasetId], references: [id], onDelete: Cascade)
	name                String
	format              VendorExportFormat
	fileName            String
	// { columnA, columnB } for the pair format; { groupColumn,
	// referenceColumn } for the group format.
	mapping             Json
	// The user confirmed this export lists every match the vendor made
	// (an omitted pair then means "not matched").
	confirmedCompleteAt DateTime           @db.Timestamptz(6)
	pairCount           Int
	// VendorFileStats (src/server/pairsight/vendors.ts): rows read, groups,
	// duplicates and self-pairs skipped. Null for exports added before it.
	stats               Json?
	createdAt           DateTime           @default(now()) @db.Timestamptz(6)
	matches             VendorMatch[]

	@@index([evaluationId])
	@@map("vendor_exports")
}

// A vendor still being set up: named, maybe with a checked file, not yet
// confirmed complete. Kept apart from VendorExport so plans, runs and results,
// which read only exports, never see a half-finished vendor. Confirming it
// creates the export (with its matches) and deletes the draft.
model VendorDraft {
	id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	evaluationId String              @db.Uuid
	evaluation   Evaluation          @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
	datasetId    String              @db.Uuid
	dataset      SourceDataset       @relation(fields: [datasetId], references: [id], onDelete: Cascade)
	name         String
	// The rest is set together once a file passes the checks.
	format       VendorExportFormat?
	fileName     String?
	mapping      Json?
	// CanonicalPair[] of record ids, waiting for the completeness confirmation.
	pairs        Json?
	stats        Json?
	createdAt    DateTime            @default(now()) @db.Timestamptz(6)

	@@index([evaluationId])
	@@map("vendor_drafts")
}

enum UploadKind {
	records
	vendor
}

// A file as uploaded, kept while it's checked (columns, sheet, vendor
// columns) so it's sent once, not on every change. Deleted once its records
// or pairs are saved, when another file replaces it, or after a day.
model Upload {
	id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	ownerId      String     @db.Uuid
	evaluationId String     @db.Uuid
	evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
	kind         UploadKind
	fileName     String
	size         Int
	bytes        Bytes
	createdAt    DateTime   @default(now()) @db.Timestamptz(6)

	@@index([evaluationId, kind])
	@@index([createdAt])
	@@map("uploads")
}

// One vendor-matched pair, record ids in canonical order (recordAId < recordBId).
model VendorMatch {
	exportId  String       @db.Uuid
	export    VendorExport @relation(fields: [exportId], references: [id], onDelete: Cascade)
	recordAId String       @db.Uuid
	recordBId String       @db.Uuid

	@@id([exportId, recordAId, recordBId])
	@@map("vendor_matches")
}

model Run {
	id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	evaluationId      String        @db.Uuid
	evaluation        Evaluation    @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
	datasetId         String        @db.Uuid
	dataset           SourceDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
	number            Int
	origin            RunOrigin     @default(live)
	entityType        EntityType    @default(person)
	status            RunStatus     @default(running)
	stopReason        String?
	// Which background workers may take this run: those with the same
	// RUN_WORKER_POOL as the server that started it, so servers sharing a
	// database (a dev server and the e2e server) never take each other's runs.
	workerPool        String        @default("default")
	// Frozen snapshot of the configuration this run was evaluated with.
	identitySame      String
	identityDifferent String
	countryCode       String
	jevFields         String[]
	blockingRules     Json
	exportIds         String[]
	judgmentKey       String
	jevModel          String
	// Set in Rules and kept: a run's results never shift after they're seen.
	// (Runs from before Rules owned it may have had it changed on Results.)
	threshold         Float
	// The threshold the run started with, kept when `threshold` changes. Null
	// for runs started before it was recorded (their original is unknown).
	initialThreshold  Float?
	pairCount         Int
	// Of its pairs, how many had no score yet when it started: what it sent to
	// Jev. With its checking time, how fast runs go here (run-estimate.ts).
	// Null for runs started before it was recorded.
	newChecks         Int?
	createdAt         DateTime      @default(now()) @db.Timestamptz(6)
	completedAt       DateTime?     @db.Timestamptz(6)
	// The Overview, worked out once when the run finishes (run-summary.ts):
	// exact counts and patterns over every checked pair, so Results never
	// load the whole run. Null until built; the version marks its format.
	summary           Json?
	summaryVersion    Int?
	// Its pairs with a final answer (checked or couldn't be), and those that
	// failed: kept as pairs are checked, so following a run never counts its
	// pairs (runs.ts getRunProgress). Recounted exactly when they can shift
	// otherwise (start, retries, finishing); null `countedAt` = never counted.
	checkedCount      Int           @default(0)
	failedCount       Int           @default(0)
	countedAt         DateTime?     @db.Timestamptz(6)
	// Since when nothing has been answered because Jev is busy or down (the
	// run waits and carries on by itself; jev-limiter.ts). Null otherwise.
	waitingSince      DateTime?     @db.Timestamptz(6)
	pairs             RunPair[]

	@@unique([evaluationId, number])
	// The background run worker looks for its pool's running runs every second.
	@@index([status, workerPool])
	@@map("runs")
}

model RunPair {
	id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	runId              String     @db.Uuid
	run                Run        @relation(fields: [runId], references: [id], onDelete: Cascade)
	recordAId          String     @db.Uuid
	recordBId          String     @db.Uuid
	// Blocking rules that produced the pair; empty = added only because a
	// vendor matched it.
	ruleIds            String[]
	matchedByExportIds String[]
	assessmentId       String     @db.Uuid
	assessment         Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
	// What Results read, copied here when the run's summary is built
	// (run-summary.ts) so a page of Results reads this table alone and never
	// joins the whole run: the judgment's status and score as of the summary,
	// the record that comes first's sortKey, and both records' searchText.
	// Null until the first summary.
	status             AssessmentStatus?
	score              Float?
	sortKey            String?
	searchText         String?

	@@unique([runId, recordAId, recordBId])
	@@index([assessmentId])
	// Results sorted by score read a page straight off this index.
	@@index([runId, score])
	@@map("run_pairs")
}

// One Jev judgment of one pair under one judgment configuration, shared by
// every run (and every vendor) that needs it.
model Assessment {
	id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	datasetId     String           @db.Uuid
	dataset       SourceDataset    @relation(fields: [datasetId], references: [id], onDelete: Cascade)
	recordAId     String           @db.Uuid
	recordBId     String           @db.Uuid
	judgmentKey   String
	origin        RunOrigin        @default(live)
	status        AssessmentStatus @default(pending)
	score         Float?
	modelReported String?
	requestId     String?
	attempts      Int              @default(0)
	errorCode     String?
	claimedAt     DateTime?        @db.Timestamptz(6)
	// After Jev was busy: not tried again before this (assess.ts). Null = any time.
	nextTryAt     DateTime?        @db.Timestamptz(6)
	completedAt   DateTime?        @db.Timestamptz(6)
	createdAt     DateTime         @default(now()) @db.Timestamptz(6)
	runPairs      RunPair[]

	@@unique([datasetId, recordAId, recordBId, judgmentKey])
	@@index([datasetId, status])
	// The worker claims pending pairs, and stale running ones, by these.
	@@index([status, claimedAt])
	@@map("assessments")
}

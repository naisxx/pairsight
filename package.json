{
	"name": "pairsight",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.6.2",
	"engines": {
		"node": ">=22.18.0"
	},
	"prisma": {
		"schema": "prisma/schema"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint . --max-warnings=0",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --test \"scripts/*.test.mjs\" \"src/**/*.test.mts\"",
		"test:e2e": "playwright test",
		"prisma:generate": "prisma generate",
		"prisma:migrate:generate": "node --env-file-if-exists=.env scripts/generate-migration.mjs --name",
		"prisma:migrate:generate:check": "node --env-file-if-exists=.env scripts/generate-migration.mjs --check",
		"db:run-once": "node --env-file-if-exists=.env scripts/run-once-sql.mjs",
		"supabase": "pnpm dlx supabase@2.118.0",
		"jev:stub": "node scripts/jev-stub.mjs",
		"jev:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs scripts/jev-check.mts",
		"check:env": "node scripts/check-env-vars.mjs",
		"check:secrets": "node scripts/check-secrets.mjs --all",
		"check:standards": "node scripts/check-standards.mjs",
		"check:rls": "node --env-file-if-exists=.env scripts/check-rls.mjs",
		"check:ai-models": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs scripts/check-ai-models.mjs",
		"prepare": "git config core.hooksPath .githooks",
		"postinstall": "prisma generate"
	},
	"dependencies": {
		"@phosphor-icons/react": "^2.1.10",
		"@prisma/client": "^6.19.3",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-toast": "^1.2.23",
		"@sentry/nextjs": "^10.70.0",
		"@supabase/ssr": "^0.12.4",
		"@supabase/supabase-js": "^2.112.3",
		"@tanstack/react-query": "^5.101.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"libphonenumber-js": "^1.13.14",
		"motion": "^13.5.0",
		"next": "^16.3.0",
		"next-intl": "^4.13.6",
		"next-themes": "^0.4.6",
		"papaparse": "^5.7.0",
		"pino": "^10.3.1",
		"posthog-js": "^1.415.4",
		"posthog-node": "^5.48.1",
		"radix-ui": "^1.6.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-error-boundary": "^6.1.3",
		"react-is": "^19.2.0",
		"recharts": "^3.10.1",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^20",
		"@types/papaparse": "^5.5.2",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^9",
		"eslint-config-next": "^16.3.0",
		"prettier": "^3",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"prisma": "^6.19.3",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.8.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@prisma/client",
			"@prisma/engines",
			"@sentry/cli",
			"@swc/core",
			"prisma",
			"unrs-resolver"
		]
	}
}
